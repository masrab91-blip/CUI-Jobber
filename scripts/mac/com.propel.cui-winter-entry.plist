<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Schedule LIVE CUI winter snow-entry kickoffs on propel-mac.
  Default: weekdays at 06:30 and 14:30 local (AM / PM confirm windows).
  Install:
    cp scripts/mac/com.propel.cui-winter-entry.plist ~/Library/LaunchAgents/
    # Edit WorkingDirectory / StartCalendarInterval if needed
    launchctl load ~/Library/LaunchAgents/com.propel.cui-winter-entry.plist
  Requires: CURSOR_API_KEY env or ~/.config/propel/cursor-api-key
  Requires: propel-mac worker already online (com.propel.propel-mac-worker)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.propel.cui-winter-entry</string>

  <key>WorkingDirectory</key>
  <string>/Users/marcs/CUI-Jobber</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/marcs/CUI-Jobber/scripts/mac/start-winter-entry.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
